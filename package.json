{
  "name": "expiry-bud-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node dashboard/server/index.js",
    "dev:client": "vite --config dashboard/vite.config.js",
    "build": "vite build --config dashboard/vite.config.js",
    "start": "node dashboard/server/index.js",
    "test": "vitest run --config dashboard/vitest.config.js",
    "test:api": "vitest run --config dashboard/vitest.config.js tests/api",
    "test:ui": "vitest run --config dashboard/vitest.config.js tests/ui"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "jsdom": "^27.4.0",
    "supertest": "^7.2.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
